# Шаблон окружения для docker-compose. Скопируй в .env и подставь свои значения:
#   cp .env.example .env
# .env с реальными значениями НЕ коммитится (см. .gitignore).

# Общие креды Postgres (для прод/шаринга — замени на сильные)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# account-service database
ACCOUNT_DB_NAME=account_db
ACCOUNT_DB_PORT=5435

# transfer-service database
TRANSFER_DB_NAME=transfer_db
TRANSFER_DB_PORT=5436

# rabbitmq (для прод/шаринга — НЕ оставляй guest; см. заметку про loopback в ревью)
RABBITMQ_USER=change-me
RABBITMQ_PASSWORD=change-me
